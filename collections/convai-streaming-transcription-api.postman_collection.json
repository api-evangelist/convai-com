  "info": {
    "_postman_id": "34a724cc-df9d-44e5-a44e-634b2afa492f",
    "name": "Convai Streaming Transcription API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Real-time speech-to-text over a WebSocket connection. Stream 16-bit PCM,\nmono, 16 kHz audio and receive incremental transcripts. Used by the Convai\nplugins to drive low-latency voice input from players. Endpoint is\ndocumented here as an OpenAPI definition for discoverability; the live\ntransport is wss://transcribe.convai.com/stream.\n",
      "type": "text/plain"
    }
  }
