          "id": "89cd48fa-f469-484d-8026-9fb72d500f70",
          "name": "Open Streaming Transcription WebSocket",
          "request": {
            "name": "Open Streaming Transcription WebSocket",
            "description": {
              "content": "Upgrade to WebSocket. Send 16-bit PCM, mono, 16 kHz audio binary\nframes. Receive JSON transcript frames with `text`, `is_final`, and\n`confidence`. Authentication via `CONVAI-API-KEY` header or\n`?convai-api-key=` query parameter.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "convai-api-key",
                  "value": "<string>",
                  "description": "Optional alternative to the header auth"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "51d79579-c2ea-42ab-a756-5f1033125605",
              "name": "Switching Protocols (WebSocket upgrade)",
              "originalRequest": {
                "url": {
                  "path": [
                    "stream"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "convai-api-key",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "CONVAI-API-KEY",
                    "value": "<API Key>"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "Switching Protocols",
              "code": 101,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://transcribe.convai.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
