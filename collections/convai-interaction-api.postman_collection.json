  "info": {
    "_postman_id": "2314ab97-0100-4050-b038-20ef73ab05d4",
    "name": "Convai Interaction API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Interaction API is the runtime conversational endpoint for Convai\ncharacters. Send user text or audio with a sessionID and characterID and\nreceive the character's spoken and animated response, including text reply,\naudio bytes, action triggers, emotion state, and lip-sync data. This is the\nendpoint that powers in-game and in-world NPC conversations.\n",
      "type": "text/plain"
    }
  }
