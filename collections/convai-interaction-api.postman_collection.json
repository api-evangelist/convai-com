          "name": "Get Character Response",
          "request": {
            "name": "Get Character Response",
            "description": {
              "content": "Send user input to a Convai character and receive its conversational\nresponse. Supports text and audio input, with audio, text, action, and\nemotion outputs. Use sessionID=\"-1\" to start a new conversation.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "character",
                "getResponse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userText",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) User input as text. Use \"(USER_PERFORMED_ACTIONS)\" placeholder when sending audio."
                },
                {
                  "key": "charID",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "sessionID",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Use \"-1\" to start a new session"
                },
                {
                  "key": "voiceResponse",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "(Required) Whether to include audio in the response"
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "Optional audio file (wav) for voice input"
                }
              ]
            }
          },
          "response": [
            {
              "id": "01ef4d74-1ca9-4080-b8dd-cf6365bb04b2",
              "name": "Character response",
