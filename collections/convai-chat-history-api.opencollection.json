            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.convai.com/character/chat-history/get-session",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get Session Transcript"
        }
      ]
    }
  ],
  "bundled": true
